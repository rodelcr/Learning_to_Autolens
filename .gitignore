# ============================================================
# .gitignore — Learning to Autolens
# ============================================================

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
*.egg
dist/
build/
.venv/
venv/
env/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints/

# --- PyAutoLens output ---
output/
output*/

# --- OS files ---
.DS_Store
Thumbs.db

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Claude Code ---
.claude/
.claude/settings.local.json

# --- Sandboxed reference workspaces (large; pinned via pip install) ---
autolens_workspace_latest/

# --- Local debug / scratch scripts ---
check_install.py
Modules/**/*_debug.py

# --- Large data (keep example datasets, exclude user data) ---
*.fits.gz
# Note: small example .fits in dataset/ ARE tracked

# --- LaTeX artifacts ---
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.synctex.gz

# --- Mathematica temp files ---
*.mx
*.m~
FrontEnd/
