# ============================================================
# .gitignore — Learning to Autolens
# ============================================================

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
*.egg
dist/
build/
.venv/
venv/
env/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints/

# --- PyAutoLens output ---
output/
output*/

# --- Published figures produced by Mod 08 notebook execution (regenerate on run) ---
Modules/08_Results_Diagnostics_Figures/figures/

# --- Slurm logs ---
logs/

# --- OS files ---
.DS_Store
Thumbs.db

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Claude Code ---
.claude/*
!.claude/skills/
.claude/settings.local.json

# --- Sandboxed reference workspaces (large; pinned via pip install) ---
autolens_workspace_latest/

# --- Cannon user-specific config (see cannon.env.example) -------------------
Modules/10_Cluster_Computing/cannon.env

# --- Local debug / scratch scripts ---
check_install.py
Modules/**/*_debug.py

# --- Large data (keep example datasets, exclude user data) ---
*.fits.gz
# Note: small example .fits in dataset/ ARE tracked

# --- LaTeX artifacts ---
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.synctex.gz

# --- Mathematica temp files ---
*.mx
*.m~
FrontEnd/
# Large MCMC chain CSVs (stripped from history 2026-05-03 to fit GitHub 100MB limit)
Examples/compound_lens/results/slam_staged/stage_3_joint/samples.csv
Examples/compound_lens_zoo/results/mock_2_R5_freecosmo/samples.csv
Examples/compound_lens_zoo/results/mock_3_R5/samples.csv
Examples/compound_lens_zoo/results/mock_3_R5_freecosmo/samples.csv
Examples/compound_lens_zoo/results/mock_3_R5_staged_stage2_R5/samples.csv
Examples/compound_lens_zoo/results/mock_4_R5/samples.csv
Examples/compound_lens_zoo/results/mock_4_R5_staged_stage2_R5/samples.csv
