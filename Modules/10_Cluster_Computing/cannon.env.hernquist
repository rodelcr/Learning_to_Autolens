# ============================================================
# cannon.env.hernquist — pre-filled config for Hernquist-lab members
# ============================================================
#
# Hernquist-lab-tailored variant of cannon.env.example. All lab-specific
# values (storage path, account, partition) are set; the only field a
# student needs to fill in is CANNON_USER on line 32.
#
# ONE-TIME SETUP:
#   cp Modules/10_Cluster_Computing/cannon.env.hernquist \
#      Modules/10_Cluster_Computing/cannon.env
#   $EDITOR Modules/10_Cluster_Computing/cannon.env   # set CANNON_USER
#
# The real `cannon.env` is git-ignored. See SETUP_NEW_USER.md for the
# full onboarding walk-through (SSH alias, conda env bootstrap, etc.).
# ============================================================

# ---- SSH connection ---------------------------------------------------------
# Assumes you have an alias `cannon` in ~/.ssh/config with ControlMaster.
# See SETUP_NEW_USER.md §1 if you don't have that block yet — it lets Duo 2FA
# prompt you only once per session instead of on every push/pull/submit.
export CANNON_SSH="cannon"

# ---- Cannon account details -------------------------------------------------
# TODO: set this to your Cannon username (the one you SSH in with).
export CANNON_USER="TODO_your_cannon_username"

# Hernquist-lab storage on holystore01. Code + datasets + Nautilus output
# all live here (~unlimited quota, persistent — unlike scratch).
export CANNON_REPO_ROOT="/n/holystore01/LABS/hernquist_lab/Lab/${CANNON_USER}/learning_to_autolens"

# ---- Slurm settings ---------------------------------------------------------
# Hernquist SIAG fairshare. Confirm with `sshare -U` on Cannon — if you
# don't see siag_lab listed, you're not in the SIAG group yet (ask Mark
# Vogelsberger / Lars Hernquist to add you).
export SLURM_ACCOUNT="siag_lab"

# siag_gpu = Hernquist SIAG nodes (64 CPUs, 515 GB RAM per node, short
# queue, priority for siag_lab). Despite the name, you don't need a GPU
# request — autolens 2026.4's JAX backend runs on CPU and skipping
# --gres=gpu just gives you CPU cores. If siag_gpu is unexpectedly busy,
# `shared` is the FASRC-wide fallback.
export SLURM_PARTITION="siag_gpu"

# Default resources. 32 cores + 64 GB fills half a siag_gpu node so a
# second siag_lab job fits, and stays inside Nautilus's useful-scaling
# regime (returns diminish past ~32 workers because of the per-likelihood
# fork-lock contention). Override per-submission with sbatch flags:
#   sbatch --time=48:00:00 --mem=128G --export=ALL,MODULE=05 ...
export SLURM_MEM="64G"
export SLURM_TIME="24:00:00"
export SLURM_CPUS_PER_TASK="32"

# ---- Conda env name ---------------------------------------------------------
# autolens312 is the only working env on Cannon as of 2026-05.
# SETUP_NEW_USER.md §3 has the bootstrap commands if you haven't built it yet.
export CONDA_ENV="autolens312"

# ---- Email notifications (optional) ----------------------------------------
# Uncomment to receive BEGIN/END/FAIL emails from Slurm.
# export SLURM_MAIL_USER="you@cfa.harvard.edu"
# export SLURM_MAIL_TYPE="BEGIN,END,FAIL"
