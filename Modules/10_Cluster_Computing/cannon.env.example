# ============================================================
# cannon.env.example — Cannon cluster configuration template
# ============================================================
#
# Every user has a different Cannon username, lab-storage path, and
# fairshare account. This file centralizes those overrides so the
# cluster scripts (push / pull / submit_to_cannon.sh + submit_cannon.slurm)
# don't have user-specific defaults hard-coded.
#
# ONE-TIME SETUP:
#   cp Modules/10_Cluster_Computing/cannon.env.example \
#      Modules/10_Cluster_Computing/cannon.env
#   $EDITOR Modules/10_Cluster_Computing/cannon.env
#
# The real `cannon.env` is git-ignored — your settings don't
# leave the laptop. The scripts auto-source it when present.
# See SETUP_NEW_USER.md for the full onboarding walk-through.
# ============================================================

# ---- SSH connection ---------------------------------------------------------
# An alias in ~/.ssh/config with ControlMaster auto + ControlPath set, so
# Duo 2FA only prompts once per session across push/submit/pull.
# Example ~/.ssh/config block:
#
#   Host cannon
#       User <your_cannon_user>
#       HostName login.rc.fas.harvard.edu
#       ControlMaster auto
#       ControlPath ~/.ssh/connections/%r@%h:%p
#       ControlPersist 10m
#
# If you don't have an alias set up, you can put a full user@host
# string here and pay the Duo prompt per call.
export CANNON_SSH="cannon"

# ---- Cannon account details -------------------------------------------------
# Your Cannon username (used to construct the remote path below).
export CANNON_USER="your_cannon_username"

# Absolute path to the repo on Cannon. The scripts rsync here, the
# slurm job reads from here, and export_results.py writes its lightweight
# artifacts into its Modules/*/results/ subtree.
#
# Typical paths:
#   Hernquist lab members:  /n/holystore01/LABS/hernquist_lab/Lab/${CANNON_USER}/learning_to_autolens
#   Other lab members:      /n/holystore01/LABS/<pi>_lab/Lab/${CANNON_USER}/learning_to_autolens
#   No lab storage:         /n/holyscratch01/users/${CANNON_USER}/learning_to_autolens
#                           (scratch is purged after 90 days — not ideal for
#                            long-running projects)
export CANNON_REPO_ROOT="/n/holystore01/LABS/<your_lab>_lab/Lab/${CANNON_USER}/learning_to_autolens"

# ---- Slurm settings ---------------------------------------------------------
# Which fairshare account to bill. Check with `sshare -U` on Cannon to
# see what you have access to.
#   Hernquist SIAG members: siag_lab
#   Default per-user:       <your_user>_lab   (usually works for FASRC-wide
#                           shared partitions)
export SLURM_ACCOUNT="siag_lab"

# Partition. Pick the one your account has priority on — don't burn queue
# time on `shared` if a lab partition will run immediately.
#   siag_gpu       — Hernquist SIAG GPU nodes. Priority access for siag_lab
#                    members; short queue. Despite the name, the nodes also
#                    have plenty of CPU; if you don't request --gres=gpu
#                    you'll just get CPU cores (which is what the current
#                    fit_module*.py scripts use — autolens 2026.4's JAX
#                    backend is NumPy/CPU in these pipelines, not CUDA).
#   shared         — FASRC-wide workhorse, up to 7 d wall clock, ~48 cores/node.
#                    Longer queue but always reachable.
#   test           — fast queue, 8 h max wall clock.
#   serial_requeue — dispatches fastest but jobs can be killed and requeued.
#                    Fine with Nautilus's checkpoint auto-resume.
export SLURM_PARTITION="siag_gpu"

# Default resources (overridable per-submission via `sbatch ... --mem=...`)
#
# For siag_gpu (64 CPUs, 515 GB RAM per node), 32 cores and 64 GB is a
# sensible default: fills half the node so another siag_lab job fits, stays
# inside Nautilus's useful-scaling regime (~0.7× past 32 workers), and
# leaves plenty of memory headroom. For shared (48 CPUs, 192 GB), drop to
# 16–24 cores and 32 GB so your job reaches the front of the queue faster.
#
# Nautilus parallelizes the likelihood evaluation via Python multiprocessing,
# which is why submit_cannon.slurm pins OPENBLAS/MKL/OMP threads to 1 (double
# parallelization deadlocks the fork-lock). Changing SLURM_CPUS_PER_TASK
# propagates to Nautilus's `number_of_cores` via `SettingsSearch`.
export SLURM_MEM="64G"
export SLURM_TIME="24:00:00"
export SLURM_CPUS_PER_TASK="32"

# ---- Conda env name ---------------------------------------------------------
# The env we activate on Cannon before running the fit. Must have
# Python 3.12 + autolens ≥ 2026.4.13. SETUP_NEW_USER.md has the bootstrap
# commands.
export CONDA_ENV="autolens312"

# ---- Email notifications (optional) ----------------------------------------
# Uncomment to receive BEGIN/END/FAIL emails from Slurm.
# export SLURM_MAIL_USER="you@your-domain.edu"
# export SLURM_MAIL_TYPE="BEGIN,END,FAIL"
